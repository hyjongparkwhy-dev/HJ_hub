# Copy to .env. Never commit .env.
# Supabase → RichRich project → Connect → Session pooler URI (with the DB password)
RICHRICH_DATABASE_URL=
# Same value as apt-leader/pipeline/.env DATABASE_URL
APT_DATABASE_URL=
# apt-leader complex.key of 내 집 and its size band (59 / 74 / 84 / large)
APT_HOME_KEY=
APT_HOME_BAND=
# Short description of the owner for Claude, e.g. where they live (kept out of the repository)
HUB_OWNER_CONTEXT=

# Collector writes the hub schema (same database as RICHRICH_DATABASE_URL)
HUB_DATABASE_URL=

# Morning briefing: a dedicated bot from @BotFather and the chat id of your conversation with it
HUB_TELEGRAM_TOKEN=
HUB_TELEGRAM_CHAT_ID=
# Optional: one summary call per day; without it the briefing uses feed descriptions
GEMINI_API_KEY=
GEMINI_MODEL=
